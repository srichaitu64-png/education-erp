# ==============================================================================
# Enterprise Multi-Tenant Education ERP - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME="Education ERP Commercial SaaS"
API_V1_STR=/api/v1
SECRET_KEY=
# Optional one-time platform administrator bootstrap password for a brand-new database only.
# At least 14 characters. Never commit a real value. Existing administrator passwords are not reset.
INITIAL_SUPERADMIN_PASSWORD=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL 16)
# Use a URL-safe password for Docker Compose (generate one with: openssl rand -hex 32).
# Copy this template to .env and replace every placeholder before running services.
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
ERP_APP_PASSWORD=
POSTGRES_DB=education_erp_dev
DATABASE_URL=postgresql+asyncpg://erp_app:SET_A_URL_SAFE_APP_PASSWORD@127.0.0.1:5433/education_erp_dev
SYNC_DATABASE_URL=postgresql+psycopg2://erp_app:SET_A_URL_SAFE_APP_PASSWORD@127.0.0.1:5433/education_erp_dev

# Test Database Configuration
TEST_DATABASE_URL=postgresql+asyncpg://erp_app:erp_app_pass@127.0.0.1:5433/education_erp_test
# Test-only privileged connection used by pytest to create/drop the disposable test schema.
TEST_ADMIN_DATABASE_URL=postgresql+asyncpg://postgres:SET_A_LOCAL_DATABASE_PASSWORD@127.0.0.1:5433/education_erp_test

# Domain & Subdomain Configuration
BASE_DOMAIN=erp.local
SUPERADMIN_SUBDOMAIN=admin

# Redis Configuration (Optional in local dev, fallback to memory)
REDIS_URL=redis://127.0.0.1:6379/0

# Object Storage (S3 / MinIO)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=education-erp-documents
S3_REGION=ap-south-1

# Payment Gateway (Razorpay India)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

