# ==============================================================================
# Enterprise Multi-Tenant Education ERP - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME="Education ERP Commercial SaaS"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-256-bit-key-in-production
# Required for the first production bootstrap only; never commit a real value.
INITIAL_SUPERADMIN_PASSWORD=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL 16)
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=education_erp_dev
DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5433/education_erp_dev
SYNC_DATABASE_URL=postgresql+psycopg2://postgres@127.0.0.1:5433/education_erp_dev

# Test Database Configuration
TEST_DATABASE_URL=postgresql+asyncpg://erp_app:erp_app_pass@127.0.0.1:5433/education_erp_test
TEST_ADMIN_DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5433/education_erp_test

# Domain & Subdomain Configuration
BASE_DOMAIN=erp.local
SUPERADMIN_SUBDOMAIN=admin

# Redis Configuration (Optional in local dev, fallback to memory)
REDIS_URL=redis://127.0.0.1:6379/0

# Object Storage (S3 / MinIO)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=education-erp-documents
S3_REGION=ap-south-1

# Payment Gateway (Razorpay India)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

