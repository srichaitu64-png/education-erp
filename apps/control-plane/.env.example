# Copy to .env in the control-plane runtime. Never commit real secrets.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://control_plane:change-me@localhost:5432/education_control
PLATFORM_ADMIN_TOKEN=replace-with-at-least-32-random-characters
LICENSE_PRIVATE_KEY_PEM=
LICENSE_PUBLIC_KEY_PEM=
LICENSE_ISSUER=https://control.yourerp.example
LICENSE_AUDIENCE=educationos-institution-erp
AUTO_CREATE_SCHEMA=false
